/* ====================================
   ARCHIVO: AjustesEstilos.uss
   DESCRIPCIÓN: Estilos para la pantalla de Ajustes/Opciones
   ==================================== */

/* ====================================
   BOTÓN VOLVER
   ==================================== */

#Boton_Volver {
    transition-duration: 0.3s;
    transition-property: scale, background-color;
}

#Boton_Volver:hover {
    scale: 1.15;
    background-color: rgba(180, 90, 30, 0.95);
}

#Boton_Volver:active {
    scale: 0.9;
}

/* ====================================
   SECCIONES DE OPCIONES
   ==================================== */

.seccion-opciones {
    transition-duration: 0.2s;
}

/* ====================================
   SLIDERS DE AUDIO
   ==================================== */

/* Estilo del handle (dragger) del slider */
#Slider_Musica .unity-base-slider__dragger,
#Slider_SFX .unity-base-slider__dragger {
    background-color: rgb(255, 215, 0);
    border-radius: 10px;
    width: 20px;
    height: 20px;
}

/* Estilo de la barra del slider */
#Slider_Musica .unity-base-slider__tracker,
#Slider_SFX .unity-base-slider__tracker {
    background-color: rgba(100, 100, 100, 0.5);
    height: 10px;
    border-radius: 5px;
}

/* Remover borde del dragger */
#Slider_Musica .unity-base-slider__dragger-border,
#Slider_SFX .unity-base-slider__dragger-border {
    border-width: 0;
}

/* ====================================
   TOGGLES DE ACCESIBILIDAD
   ==================================== */

/* Estilo del checkbox (checkmark) del toggle */
#Toggle_Daltonicos .unity-toggle__checkmark {
    background-color: rgba(100, 100, 100, 0.5);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(255, 215, 0);
}

/* Estilo del checkbox cuando está activado */
#Toggle_Daltonicos:checked .unity-toggle__checkmark {
    background-color: rgb(255, 215, 0);
}

/* ====================================
   SLIDER DE ACCESIBILIDAD (TAMAÑO LETRA)
   ==================================== */

/* Estilo del handle del slider de tamaño de letra */
#Slider_TamanoLetra .unity-base-slider__dragger {
    background-color: rgb(255, 215, 0);
    border-radius: 10px;
    width: 20px;
    height: 20px;
}

/* Estilo de la barra del slider de tamaño de letra */
#Slider_TamanoLetra .unity-base-slider__tracker {
    background-color: rgba(100, 100, 100, 0.5);
    height: 10px;
    border-radius: 5px;
}

/* Remover borde del dragger */
#Slider_TamanoLetra .unity-base-slider__dragger-border {
    border-width: 0;
}

/* ====================================
   BOTONES DE OPCIONES
   ==================================== */

/* Transiciones para todos los botones de opciones */
.boton-opcion {
    transition-duration: 0.3s;
    transition-property: scale, background-color;
}

/* Efecto hover general para botones */
/*.boton-opcion:hover {
    scale: 1.05;
    border-width: 4px !important;
}*/

/* Efecto click para botones */
.boton-opcion:active {
    scale: 0.98;
}

/* Botón de Créditos - Hover */
#Boton_Creditos:hover {
    background-color: rgba(160, 80, 20, 0.95);
}

/* Botón de Ranking - Hover */
#Boton_Ranking:hover {
    background-color: rgba(160, 80, 20, 0.95);
}

/* Botón de Perfil - Hover */
#Boton_Perfil:hover {
    background-color: rgba(160, 80, 20, 0.95);
}

/* Botón de Perfil - Hover */
#Boton_Perfil:hover {
    background-color: rgba(160, 80, 20, 0.95);
}

/* Botón de Cerrar Sesión - Hover (color rojo) */
/*#Boton_CerrarSesion:hover {
    background-color: rgba(220, 20, 20, 0.95);
    border-color: white !important;
}*/
/* CLASE MAESTRA DE DALTONISMO */
.modo-daltonico-activado Label {
    color: white !important; /* Cambiamos el oro por blanco puro */
}

.modo-daltonico-activado .seccion-opciones, 
.modo-daltonico-activado .boton-opcion {
    border-color: #0077FF !important; /* Cambiamos el marrón por un azul vibrante */
    background-color: #111111 !important; /* Fondo más oscuro para contraste */
}

.modo-daltonico-activado #Titulo {
    color: #00FFFF !important; /* Título en Cyan */
}