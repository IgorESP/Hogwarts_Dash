/* Estilos para el contenedor principal */
#Contenedor {
    width: 100%;
    height: 100%;
    background-image: url('project://database/Assets/ASSETS_MENUS/fondo%20(1).png');
    -unity-background-scale-mode: scale-and-crop;
}

/* Estilos base para todos los botones */
Button {
    transition-duration: 0.3s;
    transition-property: scale;
    transition-timing-function: ease-out;
}

/* Efecto hover - botones se agrandan */
Button:hover {
    scale: 1.15;
    transition-duration: 0.2s;
}

/* Efecto al hacer click - se encogen un poco */
Button:active {
    scale: 0.95;
    transition-duration: 0.1s;
}

/* Botón Play específico */
#Boton_play {
    cursor: url('default');
}

#Boton_play:hover {
    scale: 1.2;
}

/* Botones laterales (Perfil y Ajustes) */
#Boton_perfil:hover,
#Boton_Ajustes:hover {
    scale: 1.15;
    rotate: 5deg;
}

#Boton_Salir:hover {
    background-color: rgb(255, 0, 0);
    scale: 1.1;
}