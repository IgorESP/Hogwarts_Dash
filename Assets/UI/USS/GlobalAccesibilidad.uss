/* ============================================================
   ARCHIVO: GlobalAccesibilidad.uss
   Este archivo debe estar vinculado en el UIDocument de 
   TODAS las escenas (Login, Registro, Menu, Ajustes).
   ============================================================ */

/* ------------------------------------------------------------
   1. MODO DALTÓNICO (ALTO CONTRASTE)
   Se activa añadiendo la clase 'modo-daltonico-activado' al root
   ------------------------------------------------------------ */

/* Colores de texto: De Oro/Amarillo a Blanco Puro */
.modo-daltonico-activado Label {
    color: rgb(255, 255, 255) !important;
    -unity-text-outline-color: rgb(0, 0, 0) !important;
    -unity-text-outline-width: 1px;
}

/* Paneles y Secciones: De Marrón a Azul Intenso */
.modo-daltonico-activado .seccion-opciones,
.modo-daltonico-activado #PanelLogin,
.modo-daltonico-activado #PanelRegistro,
.modo-daltonico-activado .panel-ui {
    border-color: rgb(0, 150, 255) !important; /* Azul Eléctrico */
    background-color: rgb(15, 15, 20) !important; /* Fondo casi negro */
    border-width: 5px !important;
}

/* Botones: De Marrón/Verde a Azul y Cian */
.modo-daltonico-activado Button,
.modo-daltonico-activado .boton-opcion,
.modo-daltonico-activado .boton-login {
    background-color: rgb(0, 90, 210) !important;
    border-color: rgb(255, 255, 255) !important;
    color: rgb(255, 255, 255) !important;
}

.modo-daltonico-activado Button:hover,
.modo-daltonico-activado .boton-login:hover {
    background-color: rgb(0, 180, 255) !important;
    scale: 1.05;
}

/* Títulos: De Dorado a Cian brillante */
.modo-daltonico-activado #Titulo, 
.modo-daltonico-activated .titulo-escena {
    color: rgb(0, 255, 255) !important; 
    -unity-text-outline-color: rgb(0, 0, 0) !important;
}

/* Campos de texto (Input) */
.modo-daltonico-activado .unity-text-field__input {
    background-color: rgb(255, 255, 255) !important;
    color: rgb(0, 0, 0) !important;
    border-color: rgb(0, 150, 255) !important;
}

/* Sliders y Toggles */
.modo-daltonico-activado .unity-base-slider__dragger,
.modo-daltonico-activado .unity-toggle__checkmark {
    background-color: rgb(0, 255, 255) !important;
}


/* ------------------------------------------------------------
   2. FIX DE TAMAÑO DE TEXTO (ACCESIBILIDAD)
   Ayuda a que los textos grandes no desaparezcan
   ------------------------------------------------------------ */

/* Clase para permitir que el texto crezca y se ajuste */
.texto-accesible Label {
    white-space: normal !important; /* Permite saltos de línea */
    overflow: visible !important;   /* No corta el texto */
    -unity-text-align: middle-center;
}

/* Ajuste específico para sliders cuando el texto es grande */
.texto-accesible .unity-base-slider__label {
    min-width: 150px;
}