/* ============================================
   SISTEMA DE ACCESIBILIDAD GLOBAL
   ============================================ */

/* --------------------------------------------
   TAMAÑO DE LETRA BASE
   -------------------------------------------- */
:root {
    font-size: 108%; /* Por defecto 100% */
}

/* --------------------------------------------
   MODO DALTÓNICO (Deuteranopia/Protanopia)
   Colores: Azul #0000FF y Cian #00FFFF
   -------------------------------------------- */

/* === LOGIN Y REGISTRO === */
.modo-daltonico .error-label {
    color: rgb(0, 150, 255) !important; /* Azul claro para errores */
}

.modo-daltonico .btn-login,
.modo-daltonico .btn-registro {
    background-color: rgb(0, 100, 200) !important;
    border-color: rgb(0, 200, 255) !important;
}

.modo-daltonico .btn-login:hover,
.modo-daltonico .btn-registro:hover {
    background-color: rgb(0, 150, 255) !important;
}

.modo-daltonico .input-field {
    border-color: rgb(0, 150, 255) !important;
}

.modo-daltonico .input-field:focus {
    border-color: rgb(0, 255, 255) !important;
    box-shadow: 0 0 10px rgba(0, 255, 255, 0.5);
}

/* === SELECCIÓN DE CASAS === */
.modo-daltonico .casa-card {
    border-color: rgb(0, 100, 200) !important;
}

.modo-daltonico .casa-card:hover {
    border-color: rgb(0, 200, 255) !important;
    box-shadow: 0 0 20px rgba(0, 200, 255, 0.6);
}

.modo-daltonico .casa-selected {
    border-color: rgb(0, 255, 255) !important;
    background-color: rgba(0, 100, 200, 0.3) !important;
}

/* === SELECCIÓN DE MUNDOS === */
.modo-daltonico .mundo-card {
    background-color: rgba(0, 50, 100, 0.8) !important;
    border-color: rgb(0, 150, 255) !important;
}

.modo-daltonico .mundo-card:hover {
    border-color: rgb(0, 255, 255) !important;
    box-shadow: 0 0 25px rgba(0, 255, 255, 0.7);
}

.modo-daltonico .mundo-bloqueado {
    background-color: rgba(50, 50, 100, 0.5) !important;
    border-color: rgb(100, 100, 150) !important;
}

/* === AJUSTES === */
.modo-daltonico .slider {
    background-color: rgba(0, 100, 200, 0.3) !important;
}

.modo-daltonico .unity-slider__dragger {
    background-color: rgb(0, 200, 255) !important;
    border-color: rgb(0, 255, 255) !important;
}

.modo-daltonico .toggle-checkmark {
    background-color: rgb(0, 200, 255) !important;
}

/* === RANKING Y CRÉDITOS === */
.modo-daltonico .ranking-panel,
.modo-daltonico .creditos-panel {
    background-color: rgba(0, 30, 80, 0.9) !important;
    border-color: rgb(0, 150, 255) !important;
}

.modo-daltonico .ranking-item:hover {
    background-color: rgba(0, 100, 200, 0.4) !important;
}

/* === MENÚ PRINCIPAL === */
.modo-daltonico .menu-button {
    background-color: rgb(0, 80, 160) !important;
    border-color: rgb(0, 150, 255) !important;
}

.modo-daltonico .menu-button:hover {
    background-color: rgb(0, 120, 200) !important;
    border-color: rgb(0, 255, 255) !important;
    box-shadow: 0 0 15px rgba(0, 255, 255, 0.6);
}

/* === MENÚ DE PAUSA === */
.modo-daltonico .pausa-panel {
    background-color: rgba(0, 20, 60, 0.95) !important;
    border-color: rgb(0, 200, 255) !important;
}

.modo-daltonico .pausa-button {
    background-color: rgb(0, 100, 200) !important;
}

.modo-daltonico .pausa-button:hover {
    background-color: rgb(0, 150, 255) !important;
}

/* === INPUTS Y TEXTFIELDS === */
.modo-daltonico .unity-text-field__input {
    border-color: rgb(0, 150, 255) !important;
}

.modo-daltonico .unity-text-field__input:focus {
    border-color: rgb(0, 255, 255) !important;
}

.modo-daltonico TextField:focus {
    border-color: rgb(0, 255, 255) !important;
}
/* ============================================
   TEXTO EN NEGRO OSCURO PARA INPUTS
   ============================================ */

/* === TEXTO QUE ESCRIBE EL USUARIO === */
.unity-text-field__input {
    color: rgb(20, 20, 20) !important; /* Negro oscuro */
    background-color: rgb(240, 240, 240) !important; /* Fondo gris claro */
    font-size: 18px !important;
    -unity-font-style: normal !important;
    padding-left: 10px !important;
    padding-right: 10px !important;
    padding-top: 8px !important;
    padding-bottom: 8px !important;
    border-radius: 5px !important;
}

/* === COLOR DEL PLACEHOLDER (MODO NORMAL) === */
.unity-base-text-field__placeholder {
    color: rgba(50, 50, 50, 0.6) !important; /* Un gris oscuro con algo de transparencia */
    -unity-font-style: italic; /* Opcional: para diferenciarlo del texto escrito */
}

/* === MODO DALTÓNICO - Mantener negro pero con fondo azul claro === */
.modo-daltonico .unity-text-field__input {
    color: rgb(0, 0, 0) !important; /* Negro */
    background-color: rgb(200, 230, 255) !important; /* Fondo azul muy claro */
}

.modo-daltonico .unity-text-field__input:focus {
    color: rgb(0, 0, 0) !important;
    background-color: rgb(255, 255, 255) !important;
    border-color: rgb(0, 255, 255) !important; /* Borde cian */
}