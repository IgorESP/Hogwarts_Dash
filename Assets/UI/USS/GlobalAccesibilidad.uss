.unity-text-field__input {
    color: rgb(20, 20, 20);
    background-color: rgb(240, 240, 240);
    font-size: 18px;
    -unity-font-style: normal;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-radius: 5px;
}

.unity-base-text-field__placeholder {
    color: rgba(88, 88, 88, 0.6);
    -unity-font-style: italic;
}

