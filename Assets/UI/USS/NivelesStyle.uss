/* ====================================
   CONTENEDOR PRINCIPAL
   ==================================== */

#Contenedor {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: flex-start;
    align-items: center;
    padding-top: 20px;
}

/* ====================================
   HEADER
   ==================================== */

#Header {
    flex-direction: row;
    width: 95%;
    max-width: 1600px;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
}

#Titulo {
    font-size: 40px;
    color: rgb(255, 215, 0);
    -unity-font-style: bold;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}

#Progreso {
    font-size: 18px;
    color: rgb(255, 215, 0);
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}

#Boton_Atras {
    width: 150px;
    height: 50px;
    font-size: 20px;
    background-color: rgba(139, 69, 19, 0.9);
    color: rgb(255, 215, 0);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(255, 215, 0);
    -unity-font-style: bold;
    transition-duration: 0.3s;
}

#Boton_Atras:hover {
    scale: 1.05;
    background-color: rgba(180, 90, 30, 0.9);
}

#Boton_Atras:active {
    scale: 0.95;
}

/* ====================================
   FILAS DE MUNDOS
   ==================================== */

#FilaMundos1,
#FilaMundos2 {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    width: 100%;
    margin-bottom: 30px;
}

#FilaMundos1 {
    gap: 10px;
}

#FilaMundos2 {
    gap: 10px;
}

/* ====================================
   TARJETAS
   ==================================== */

.tarjeta-mundo {
    width: 250px;
    height: 350px;
    margin: 15px;
    background-color: rgba(20, 20, 20, 0.85);
    border-width: 4px;
    border-radius: 20px;
    padding: 20px;
    transition-duration: 0.3s;
}

/* ====================================
   TARJETAS DESBLOQUEADAS
   ==================================== */

.tarjeta-mundo.desbloqueado {
    opacity: 1;
}

.tarjeta-mundo.desbloqueado:hover {
    scale: 1.05;
    border-width: 5px;
}

.tarjeta-mundo.desbloqueado:active {
    scale: 0.98;
}

/* ====================================
   TARJETAS BLOQUEADAS
   ==================================== */

.tarjeta-mundo.bloqueado {
    opacity: 0.4;
    background-color: rgba(20, 20, 20, 0.3);
    border-color: rgb(60, 60, 60);
}

.tarjeta-mundo.bloqueado:hover {
    scale: 1.0;
}

.tarjeta-mundo.bloqueado Label {
    color: rgb(100, 100, 100);
    opacity: 0.5;
}

.tarjeta-mundo.bloqueado VisualElement {
    opacity: 0.3;
}

/* ====================================
   COLORES POR CASA - DESBLOQUEADOS
   ==================================== */

/* COMEDOR - GRIS */
#Mundo_1.desbloqueado {
    border-color: rgb(150, 150, 150);
}

#Mundo_1.desbloqueado:hover {
    border-color: rgb(255, 255, 255);
    border-width: 6px;
}

/* GRYFFINDOR - ROJO */
#Mundo_2.desbloqueado {
    border-color: rgb(116, 0, 1);
}

#Mundo_2.desbloqueado:hover {
    border-color: rgb(200, 30, 30);
    border-width: 6px;
}

/* SLYTHERIN - VERDE */
#Mundo_3.desbloqueado {
    border-color: rgb(26, 71, 42);
}

#Mundo_3.desbloqueado:hover {
    border-color: rgb(40, 150, 60);
    border-width: 6px;
}

/* HUFFLEPUFF */
#Mundo_4.desbloqueado {
    border-color: rgb(236, 185, 57);
}

#Mundo_4.desbloqueado:hover {
    border-color: rgb(255, 230, 0);
    border-width: 6px;
}

/* RAVENCLAW - AZUL */
#Mundo_5.desbloqueado {
    border-color: rgb(14, 26, 64);
}

#Mundo_5.desbloqueado:hover {
    border-color: rgb(30, 80, 220);
    border-width: 6px;
}

/* ====================================
   MUNDOS BLOQUEADOS
   ==================================== */

#Mundo_1.bloqueado,
#Mundo_2.bloqueado,
#Mundo_3.bloqueado,
#Mundo_4.bloqueado,
#Mundo_5.bloqueado {
    border-color: rgb(60, 60, 60);
    background-color: rgba(15, 15, 15, 0.5);
}

/* ====================================
   TEXTOS LARGOS EN DOS LÍNEAS
   ==================================== */

.tarjeta-mundo Label {
    white-space: normal;
    -unity-text-align: upper-center;
}

/* ====================================
   BOTONES ADICIONALES
   ==================================== */

#Boton_Reset_Progreso {
    width: 200px;
    height: 50px;
    font-size: 16px;
    background-color: rgba(139, 69, 19, 0.9);
    color: rgb(255, 215, 0);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(255, 215, 0);
    -unity-font-style: bold;
    transition-duration: 0.3s;
    margin-left: 20px;
}

#Boton_Reset_Progreso:hover {
    scale: 1.05;
    background-color: rgba(180, 50, 50, 0.9);
}

#Boton_Reset_Progreso:active {
    scale: 0.95;
}