/* ====================================
   ESTILOS GENERALES
   ==================================== */

#Contenedor {
    justify-content: flex-start;
}

/* ====================================
   BOTÓN ATRÁS
   ==================================== */

#Boton_Atras {
    transition-duration: 0.3s;
    transition-property: scale, background-color;
}

#Boton_Atras:hover {
    scale: 1.05;
    background-color: rgba(180, 90, 30, 0.9);
}

#Boton_Atras:active {
    scale: 0.95;
}

/* ====================================
   TARJETAS DE MUNDO
   ==================================== */

.tarjeta-mundo {
    transition-duration: 0.3s;
    transition-property: scale, border-color, background-color;
    cursor: default;
}

/* Tarjetas desbloqueadas */
.tarjeta-mundo.desbloqueado:hover {
    scale: 1.05;
    border-width: 5px !important;
    background-color: rgba(30, 30, 30, 0.95);
}

.tarjeta-mundo.desbloqueado:active {
    scale: 0.98;
}

/* Tarjetas bloqueadas */
.tarjeta-mundo.bloqueado {
    opacity: 0.6;
}

.tarjeta-mundo.bloqueado:hover {
    scale: 1.02;
    border-color: rgb(120, 120, 120);
}

/* ====================================
   EFECTOS ESPECÍFICOS POR MUNDO
   ==================================== */

/* Mundo 1 - Naranja (Gran Comedor) */
#Mundo_1:hover {
    border-color: rgb(255, 180, 50) !important;
}

/* Mundo 2 - Verde (Bosque Prohibido) */
#Mundo_2:hover {
    border-color: rgb(50, 255, 150) !important;
}

/* Mundo 3 - Azul (Torre de Astronomía) */
#Mundo_3:hover {
    border-color: rgb(100, 180, 255) !important;
}

/* ====================================
   ANIMACIONES ADICIONALES
   ==================================== */

.tarjeta-mundo Label {
    transition-duration: 0.2s;
}

.tarjeta-mundo:hover Label {
    color: rgb(255, 255, 255);
}
