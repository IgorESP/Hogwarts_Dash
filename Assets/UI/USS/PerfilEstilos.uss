/* ====================================
   ANIMACIONES Y TRANSICIONES SUAVES
   ==================================== */

.boton-casa {
    transition-duration: 0.3s;
    transition-property: scale, border-width, border-color, rotate;
}

.boton-casa:hover {
    scale: 1.15;
    border-width: 6px !important;
    border-color: rgb(255, 255, 255) !important;
    rotate: 3deg;
}

.boton-casa:active {
    scale: 0.95;
}

/* ====================================
   CASA SELECCIONADA - MUY VISIBLE
   ==================================== */

.casa-seleccionada {
    border-width: 7px !important;
    border-color: white !important;
    scale: 1.2;
    box-shadow: 0 0 25px rgba(255, 255, 255, 0.8);
}

/* ====================================
   ICONOS DE CASA CON ANIMACIÓN
   ==================================== */

.icono-casa {
    transition-duration: 0.4s;
    transition-property: scale, rotate, border-color;
}

.icono-casa:hover {
    scale: 1.25;
    rotate: 10deg;
    border-color: rgb(255, 255, 255) !important;
}

/* ====================================
   COLORES GRYFFINDOR (ROJO)
   ==================================== */

.color-gryffindor #Boton_Confirmar {
    background-color: rgb(174, 0, 1);
    border-color: rgb(255, 215, 0);
    color: rgb(255, 215, 0);
}

.color-gryffindor #Boton_Confirmar:hover {
    background-color: rgb(220, 30, 30);
    scale: 1.08;
    border-color: rgb(255, 255, 255);
    border-width: 5px;
}

.color-gryffindor #Boton_Volver {
    background-color: rgba(174, 0, 1, 0.9);
    border-color: rgb(255, 215, 0);
}

.color-gryffindor #Boton_Volver:hover {
    background-color: rgb(220, 30, 30);
    scale: 1.1;
}

/* ====================================
   COLORES HUFFLEPUFF (AMARILLO)
   ==================================== */

.color-hufflepuff #Boton_Confirmar {
    background-color: rgb(236, 177, 31);
    border-color: rgb(0, 0, 0);
    color: rgb(0, 0, 0);
}

.color-hufflepuff #Boton_Confirmar:hover {
    background-color: rgb(255, 198, 51);
    scale: 1.08;
    border-color: rgb(255, 255, 255);
    border-width: 5px;
}

.color-hufflepuff #Boton_Volver {
    background-color: rgba(236, 177, 31, 0.9);
    border-color: rgb(0, 0, 0);
    color: rgb(0, 0, 0);
}

.color-hufflepuff #Boton_Volver:hover {
    background-color: rgb(255, 198, 51);
    scale: 1.1;
}

/* ====================================
   COLORES RAVENCLAW (AZUL)
   ==================================== */

.color-ravenclaw #Boton_Confirmar {
    background-color: rgb(34, 56, 116);
    border-color: rgb(150, 150, 150);
    color: rgb(255, 215, 0);
}

.color-ravenclaw #Boton_Confirmar:hover {
    background-color: rgb(54, 76, 136);
    scale: 1.08;
    border-color: rgb(255, 255, 255);
    border-width: 5px;
}

.color-ravenclaw #Boton_Volver {
    background-color: rgba(34, 56, 116, 0.9);
    border-color: rgb(150, 150, 150);
    color: rgb(255, 215, 0);
}

.color-ravenclaw #Boton_Volver:hover {
    background-color: rgb(54, 76, 136);
    scale: 1.1;
}

/* ====================================
   COLORES SLYTHERIN (VERDE)
   ==================================== */

.color-slytherin #Boton_Confirmar {
    background-color: rgb(46, 91, 62);
    border-color: rgb(170, 170, 170);
    color: rgb(255, 215, 0);
}

.color-slytherin #Boton_Confirmar:hover {
    background-color: rgb(66, 111, 82);
    scale: 1.08;
    border-color: rgb(255, 255, 255);
    border-width: 5px;
}

.color-slytherin #Boton_Volver {
    background-color: rgba(46, 91, 62, 0.9);
    border-color: rgb(170, 170, 170);
    color: rgb(255, 215, 0);
}

.color-slytherin #Boton_Volver:hover {
    background-color: rgb(66, 111, 82);
    scale: 1.1;
}

/* ====================================
   BOTONES BASE CON TRANSICIONES
   ==================================== */

#Boton_Volver {
    transition-duration: 0.3s;
    transition-property: scale, background-color, border-color;
}

#Boton_Volver:active {
    scale: 0.9;
}

#Boton_Confirmar {
    transition-duration: 0.3s;
    transition-property: scale, background-color, border-color, border-width;
}

#Boton_Confirmar:active {
    scale: 0.95;
}

/* ====================================
   PANEL PRINCIPAL CON EFECTO
   ==================================== */

#PanelPrincipal {
    transition-duration: 0.5s;
    transition-property: opacity;
    opacity: 1;
}

/* ====================================
   CONTENEDOR DE ICONOS
   ==================================== */

#ContenedorIconos {
    transition-duration: 0.5s;
    transition-property: opacity, scale;
}