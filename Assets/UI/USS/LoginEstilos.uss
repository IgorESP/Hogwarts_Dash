/* ==========================================
   CONFIGURACIÓN DE PANELES (Login y Registro)
   ========================================== */
#PanelLogin, #PanelRegistro {
    width: 650px; /* Panel más robusto para acomodar textos gigantes */
    background-color: rgba(25, 20, 15, 0.98); /* Fondo más sólido para mejor contraste */
    border-radius: 35px; 
    padding: 60px; 
    border-width: 6px; 
    border-color: rgb(139, 69, 19);
    align-items: center;
}

/* ==========================================
   ESTILO DE LOS CAMPOS (Inputs)
   ========================================== */
#Campo_Usuario, #Campo_Contrasena, #Campo_Nombre, #Campo_Apellido, #Campo_Confirmar {
    background-color: rgb(255, 255, 255) !important;
    height: 95px !important; /* Altura máxima para que el texto respire */
    border-radius: 20px !important;
    border-width: 5px !important; /* Borde más definido */
    border-color: rgba(139, 69, 19, 1) !important;
    margin-bottom: 35px;
    padding: 0;
}

/* EL TEXTO QUE ESCRIBE EL USUARIO (MÁXIMA NITIDEZ) */
.unity-text-field__input {
    color: rgb(0, 0, 0) !important;
    background-color: transparent !important;
    font-size: 48px !important; /* Texto masivo y ultra claro */
    -unity-font-style: bold;
    -unity-text-align: middle-left; /* Centrado vertical exacto */
    padding-left: 30px !important; /* Más espacio desde el borde */
    padding-right: 30px !important;
    border-width: 0 !important;
    margin: 0 !important;
}

/* Etiquetas de los campos (Usuario, Contraseña, etc.) */
.campo-input Label {
    color: gold !important;
    -unity-font-style: bold;
    font-size: 34px !important; /* Etiquetas muy grandes */
    margin-bottom: 15px;
}

/* ==========================================
   BOTONES Y EXTRAS
   ========================================== */
.boton-login {
    width: 100%;
    height: 100px !important; /* Botones imponentes */
    font-size: 36px !important; /* Letra de botón masiva */
    -unity-font-style: bold;
    border-radius: 20px;
    margin-top: 25px;
}

.boton-login:hover {
    scale: 1.05;
    background-color: rgb(0, 150, 0); /* Brillo verde al pasar el ratón */
}

#Mensaje_Error {
    color: white !important;
    background-color: rgba(220, 20, 20, 1);
    padding: 25px;
    border-radius: 20px;
    margin-top: 25px;
    -unity-text-align: middle-center;
    font-size: 28px;
    -unity-font-style: bold;
}