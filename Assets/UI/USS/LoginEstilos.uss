/* ==========================================
   CONFIGURACIÓN DE PANELES (Login y Registro)
   ========================================= */
#PanelLogin, #PanelRegistro {
    width: 650px;
    background-color: rgba(25, 20, 15, 0.98);
    border-radius: 35px; 
    padding: 60px; 
    border-width: 6px; 
    border-color: rgb(139, 69, 19);
    align-items: center;
}

/* ==========================================
   ESTILO DE LOS CAMPOS (Inputs)
   ========================================= */
#Campo_Usuario, #Campo_Contrasena, #Campo_Nombre, #Campo_Apellido, #Campo_Confirmar {
    background-color: rgb(255, 255, 255) !important;
    height: 95px !important;
    border-radius: 20px !important;
    border-width: 5px !important;
    border-color: rgba(139, 69, 19, 1) !important;
    margin-bottom: 35px;
    padding: 0;
}

/* Texto escrito por el usuario dentro del input */
.unity-text-field__input {
    color: rgb(0, 0, 0) !important;
    background-color: transparent !important;
    font-size: 52px !important;
    -unity-font-style: bold !important;
    -unity-font-weight: 900 !important;
    -unity-text-align: middle-left;
    padding-left: 35px !important;
    padding-right: 35px !important;
    border-width: 0 !important;
    margin: 0 !important;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.7) !important;
    letter-spacing: 1px !important;
}

.unity-text-field__input::placeholder {
    color: rgb(40, 40, 40) !important;
    font-size: 52px !important;
    -unity-font-style: bold !important;
    -unity-font-weight: 800 !important;
    opacity: 0.9 !important;
    text-shadow: 1px 1px 3px rgba(0,0,0,0.5) !important;
}

/* ==========================================
   ETIQUETAS GIGANTES DORADAS
   ========================================= */
.campo-input Label {
    color: gold !important;
    -unity-font-style: bold !important;
    -unity-font-weight: 900 !important;
    font-size: 38px !important;
    margin-bottom: 20px;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.6) !important;
}

/* ==========================================
   BOTONES
   ========================================= */
.boton-login {
    width: 100%;
    height: 110px !important;
    font-size: 42px !important;
    -unity-font-style: bold !important;
    -unity-font-weight: 900 !important;
    border-radius: 20px;
    margin-top: 30px;
    color: rgb(255, 255, 255) !important;
    text-shadow: 3px 3px 6px rgba(0,0,0,0.8) !important;
}

.boton-login:hover {
    scale: 1.08;
    background-color: rgb(0, 180, 0);
}

/* ==========================================
   MENSAJE DE ERROR / ÉXITO
   ========================================= */
#Mensaje_Error {
    color: rgb(255, 255, 255) !important;
    background-color: rgba(220, 20, 20, 1);
    padding: 30px;
    border-radius: 20px;
    margin-top: 30px;
    -unity-text-align: middle-center;
    font-size: 32px !important;
    -unity-font-style: bold !important;
    -unity-font-weight: 900 !important;
    text-shadow: 3px 3px 6px rgba(0,0,0,0.9) !important;
}
