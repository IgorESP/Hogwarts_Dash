<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Contenedor" style="flex-grow: 1; background-image: url('project://database/Assets/ASSETS_MENUS/fondo%20(1).png?fileID=2800000&amp;guid=0ae676ad7a14f814c9b9fbe500038b98&amp;type=3#fondo (1)'); width: 100%; height: 100%; position: absolute; -unity-background-scale-mode: scale-and-crop; align-items: center; justify-content: flex-start; padding-top: 30px;">
        <Style src="project://database/Assets/UI/USS/AjustesEstilos.uss" />
        <!-- HEADER -->
        <ui:VisualElement name="Header" style="flex-direction: row; width: 95%; justify-content: space-between; align-items: center; margin-bottom: 30px;">
            <!-- Botón Volver (Flecha) -->
            <ui:Button name="Boton_Atras" text="← ATRÁS" style="width: 150px; height: 50px; font-size: 20px; background-color: rgba(139, 69, 19, 0.9); color: rgb(255, 215, 0); border-radius: 10px; border-width: 2px; border-color: rgb(255, 215, 0); -unity-font-style: bold;" />
            
            
            <!-- Título -->
            <ui:Label text="OPCIONES" name="Titulo" style="font-size: 50px; color: rgb(255, 215, 0); -unity-font-style: bold; -unity-text-outline-width: 4px; -unity-text-outline-color: rgba(0, 0, 0, 1);" />
            
            <!-- Espacio vacío para centrar -->
            <ui:VisualElement style="width: 70px; height: 70px;" />
        </ui:VisualElement>
        
        <!-- CONTENEDOR PRINCIPAL CON SCROLL -->
        <ui:ScrollView name="ContenedorScroll" style="width: 90%; height: 80%; background-color: rgba(0, 0, 0, 0);">
            
            <!-- SECCIÓN: AUDIO -->
            <ui:VisualElement name="Seccion_Audio" class="seccion-opciones" style="background-color: rgba(20, 20, 20, 0.9); border-radius: 20px; padding: 25px; margin-bottom: 20px; border-width: 3px; border-color: rgb(139, 69, 19);">
                <ui:Label text="🔊 AUDIO" style="font-size: 30px; color: rgb(255, 215, 0); -unity-font-style: bold; margin-bottom: 20px; -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(0, 0, 0, 1);" />
                
                <!-- Música -->
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 15px;">
                    <ui:VisualElement style="width: 35px; height: 35px; background-image: url('project://database/Assets/A%20lot%20of%20useful%20icons_05/png/icon_white/43.png'); -unity-background-scale-mode: scale-to-fit; margin-right: 15px;" />
                    <ui:Label text="Música:" style="font-size: 22px; color: white; min-width: 120px; -unity-font-style: bold;" />
                    <ui:Slider name="Slider_Musica" high-value="100" value="75" style="flex-grow: 1; margin-left: 10px; margin-right: 10px;" />
                    <ui:Label name="Label_Musica" text="75%" style="font-size: 22px; color: rgb(255, 215, 0); min-width: 60px; -unity-font-style: bold;" />
                </ui:VisualElement>
                
                <!-- SFX -->
                <ui:VisualElement style="flex-direction: row; align-items: center;">
                    <ui:VisualElement style="width: 35px; height: 35px; background-image: url('project://database/Assets/A%20lot%20of%20useful%20icons_05/png/icon_white/50.png'); -unity-background-scale-mode: scale-to-fit; margin-right: 15px;" />
                    <ui:Label text="SFX:" style="font-size: 22px; color: white; min-width: 120px; -unity-font-style: bold;" />
                    <ui:Slider name="Slider_SFX" high-value="100" value="75" style="flex-grow: 1; margin-left: 10px; margin-right: 10px;" />
                    <ui:Label name="Label_SFX" text="75%" style="font-size: 22px; color: rgb(255, 215, 0); min-width: 60px; -unity-font-style: bold;" />
                </ui:VisualElement>
            </ui:VisualElement>
            
            <!-- SECCIÓN: ACCESIBILIDAD -->
            <ui:VisualElement name="Seccion_Accesibilidad" class="seccion-opciones" style="background-color: rgba(20, 20, 20, 0.9); border-radius: 20px; padding: 25px; margin-bottom: 20px; border-width: 3px; border-color: rgb(139, 69, 19);">
                <ui:Label text="♿ ACCESIBILIDAD" style="font-size: 30px; color: rgb(255, 215, 0); -unity-font-style: bold; margin-bottom: 20px; -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(0, 0, 0, 1);" />
                
                <!-- Alto Contraste -->
                <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 15px;">
                    <ui:Label text="Alto Contraste" style="font-size: 22px; color: white; -unity-font-style: bold;" />
                    <ui:Toggle name="Toggle_AltoContraste" style="width: 80px;" />
                </ui:VisualElement>
                
                <!-- Reducir Movimiento -->
                <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between;">
                    <ui:Label text="Reducir Movimiento" style="font-size: 22px; color: white; -unity-font-style: bold;" />
                    <ui:Toggle name="Toggle_ReducirMovimiento" style="width: 80px;" />
                </ui:VisualElement>
            </ui:VisualElement>
            
            <!-- SECCIÓN: BOTONES -->
            <ui:VisualElement name="Seccion_Botones" style="flex-direction: column; width: 100%;">
                
                <!-- CRÉDITOS -->
                <ui:Button name="Boton_Creditos" class="boton-opcion" style="height: 80px; background-color: rgba(139, 69, 19, 0.9); border-radius: 15px; border-width: 3px; border-color: rgb(255, 215, 0); margin-bottom: 15px; flex-direction: row; align-items: center; padding-left: 20px;">
                    <ui:VisualElement style="width: 40px; height: 40px; background-image: url('project://database/Assets/A%20lot%20of%20useful%20icons_05/png/icon_white/134.png'); -unity-background-scale-mode: scale-to-fit; margin-right: 20px;" />
                    <ui:Label text="📜 CRÉDITOS" style="font-size: 26px; color: rgb(255, 215, 0); -unity-font-style: bold; -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(0, 0, 0, 1);" />
                </ui:Button>
                
                <!-- RANKING -->
                <ui:Button name="Boton_Ranking" class="boton-opcion" style="height: 80px; background-color: rgba(139, 69, 19, 0.9); border-radius: 15px; border-width: 3px; border-color: rgb(255, 215, 0); margin-bottom: 15px; flex-direction: row; align-items: center; padding-left: 20px;">
                    <ui:VisualElement style="width: 40px; height: 40px; background-image: url('project://database/Assets/A%20lot%20of%20useful%20icons_05/png/icon_white/122.png'); -unity-background-scale-mode: scale-to-fit; margin-right: 20px;" />
                    <ui:Label text="🏆 RANKING" style="font-size: 26px; color: rgb(255, 215, 0); -unity-font-style: bold; -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(0, 0, 0, 1);" />
                </ui:Button>
                
                <!-- VER PERFIL -->
                <ui:Button name="Boton_Perfil" class="boton-opcion" style="height: 80px; background-color: rgba(139, 69, 19, 0.9); border-radius: 15px; border-width: 3px; border-color: rgb(255, 215, 0); margin-bottom: 15px; flex-direction: row; align-items: center; padding-left: 20px;">
                    <ui:VisualElement style="width: 40px; height: 40px; background-image: url('project://database/Assets/A%20lot%20of%20useful%20icons_05/png/icon_white/153.png'); -unity-background-scale-mode: scale-to-fit; margin-right: 20px;" />
                    <ui:Label text="👤 VER PERFIL" style="font-size: 26px; color: rgb(255, 215, 0); -unity-font-style: bold; -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(0, 0, 0, 1);" />
                </ui:Button>
                
                <!-- CERRAR SESIÓN -->
                <ui:Button name="Boton_CerrarSesion" class="boton-opcion" style="height: 80px; background-color: rgba(174, 0, 1, 0.9); border-radius: 15px; border-width: 3px; border-color: rgb(255, 215, 0); flex-direction: row; align-items: center; padding-left: 20px;">
                    <ui:VisualElement style="width: 40px; height: 40px; background-image: url('project://database/Assets/A%20lot%20of%20useful%20icons_05/png/icon_white/80.png'); -unity-background-scale-mode: scale-to-fit; margin-right: 20px; -unity-background-image-tint-color: rgb(255, 215, 0);" />
                    <ui:Label text="🚪 CERRAR SESIÓN" style="font-size: 26px; color: rgb(255, 215, 0); -unity-font-style: bold; -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(0, 0, 0, 1);" />
                </ui:Button>
                
            </ui:VisualElement>
            
        </ui:ScrollView>
        
    </ui:VisualElement>
</ui:UXML>
