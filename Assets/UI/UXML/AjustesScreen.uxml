<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Contenedor" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/ASSETS_MENUS/fondo%20(1).png?fileID=2800000&amp;guid=0ae676ad7a14f814c9b9fbe500038b98&amp;type=3#fondo (1)&quot;); width: 100%; height: 100%; position: absolute; -unity-background-scale-mode: scale-and-crop; align-items: center; justify-content: flex-start; padding-top: 30px; -unity-background-image-tint-color: rgb(108, 103, 103);">
        <Style src="project://database/Assets/UI/USS/AjustesEstilos.uss?fileID=7433441132597879392&amp;guid=01d7789c7a9eda741b3379e6f8ec8a29&amp;type=3#AjustesEstilos" />
        
        <!-- HEADER CON TÍTULO Y BOTÓN VOLVER -->
        <ui:VisualElement name="Header" style="flex-direction: row; width: 95%; justify-content: space-between; align-items: center; margin-bottom: 30px;">
            <ui:Button name="Boton_Atras" text="← ATRÁS" style="width: 150px; height: 50px; font-size: 20px; background-color: rgba(139, 69, 19, 0.9); color: rgb(255, 215, 0); border-radius: 10px; border-width: 2px; border-color: rgb(255, 215, 0); -unity-font-style: bold;" />
            <ui:Label text="OPCIONES" name="Titulo" style="font-size: 50px; color: rgb(255, 215, 0); -unity-font-style: bold; -unity-text-outline-width: 4px; -unity-text-outline-color: rgb(0, 0, 0);" />
            <ui:VisualElement style="width: 70px; height: 70px;" />
        </ui:VisualElement>
        
        <!-- SCROLL VERTICAL (SIN SCROLL HORIZONTAL) -->
        <ui:ScrollView name="ContenedorScroll" mode="Vertical" style="width: 90%; flex-grow: 1; background-color: rgba(0, 0, 0, 0); margin-bottom: 20px;">
            
            <!-- SECCIÓN DE AUDIO -->
            <ui:VisualElement name="Seccion_Audio" class="seccion-opciones" style="background-color: rgba(20, 20, 20, 0.9); border-radius: 20px; padding: 25px; margin-bottom: 20px; border-width: 3px; border-color: rgb(139, 69, 19);">
                <ui:Label text="AUDIO" style="font-size: 30px; color: rgb(255, 215, 0); -unity-font-style: bold; margin-bottom: 20px; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0);" />
                
                <!-- CONTROL DE MÚSICA -->
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 15px;">
                    <ui:VisualElement style="width: 35px; height: 35px; background-image: url(&quot;project://database/Assets/A%20lot%20of%20useful%20icons_05/png/icon_white/43.png?fileID=21300000&amp;guid=3e1b9a4ae214a844bb0a864020fcfa24&amp;type=3#43&quot;); -unity-background-scale-mode: scale-to-fit; margin-right: 15px;" />
                    <ui:Label text="Música:" style="font-size: 22px; color: rgb(220, 220, 220); min-width: 120px; -unity-font-style: bold;" />
                    <ui:Slider name="Slider_Musica" high-value="100" value="75" style="flex-grow: 1; margin-left: 10px; margin-right: 10px;" />
                    <ui:Label name="Label_Musica" text="75%" style="font-size: 22px; color: rgb(255, 215, 0); min-width: 60px; -unity-font-style: bold;" />
                </ui:VisualElement>
                
                <!-- CONTROL DE SFX -->
                <ui:VisualElement style="flex-direction: row; align-items: center;">
                    <ui:VisualElement style="width: 35px; height: 35px; background-image: url(&quot;project://database/Assets/A%20lot%20of%20useful%20icons_05/png/icon_white/50.png?fileID=21300000&amp;guid=9990eb331c6c0f149992882497f10eee&amp;type=3#50&quot;); -unity-background-scale-mode: scale-to-fit; margin-right: 15px;" />
                    <ui:Label text="SFX:" style="font-size: 22px; color: rgb(220, 220, 220); min-width: 120px; -unity-font-style: bold;" />
                    <ui:Slider name="Slider_SFX" high-value="100" value="75" style="flex-grow: 1; margin-left: 10px; margin-right: 10px;" />
                    <ui:Label name="Label_SFX" text="75%" style="font-size: 22px; color: rgb(255, 215, 0); min-width: 60px; -unity-font-style: bold;" />
                </ui:VisualElement>
            </ui:VisualElement>
            
            <!-- SECCIÓN DE ACCESIBILIDAD -->
            <ui:VisualElement name="Seccion_Accesibilidad" class="seccion-opciones" style="background-color: rgba(20, 20, 20, 0.9); border-radius: 20px; padding: 25px; margin-bottom: 20px; border-width: 3px; border-color: rgb(139, 69, 19);">
                <ui:Label text="ACCESIBILIDAD" style="font-size: 30px; color: rgb(255, 215, 0); -unity-font-style: bold; margin-bottom: 20px; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0);" />
                
                <!-- CONTROL DE TAMAÑO DE LETRA -->
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 15px;">
                    
                    <ui:Label text="Tamaño de Letra:" style="font-size: 22px; color: rgb(220, 220, 220); min-width: 200px; -unity-font-style: bold;" />
                    <ui:Slider name="Slider_TamanoLetra" high-value="150" low-value="80" value="100" style="flex-grow: 1; margin-left: 10px; margin-right: 10px;" />
                    <ui:Label name="Label_TamanoLetra" text="100%" style="font-size: 22px; color: rgb(255, 215, 0); min-width: 80px; -unity-font-style: bold;" />
                </ui:VisualElement>
                
                <!-- TOGGLE DE COLORES DALTÓNICOS -->
                <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between;">
                    <ui:Label text="Colores Daltónicos" style="font-size: 22px; color: rgb(220, 220, 220); -unity-font-style: bold;" />
                    <ui:Toggle name="Toggle_Daltonicos" style="width: 80px;" />
                </ui:VisualElement>
            </ui:VisualElement>
            
            <!-- SECCIÓN DE BOTONES DE NAVEGACIÓN -->
            <ui:VisualElement name="Seccion_Botones" style="flex-direction: column; width: 100%;">
                
                <!-- BOTÓN CRÉDITOS -->
                <ui:Button name="Boton_Creditos" class="boton-opcion" style="height: 80px; background-color: rgba(20, 20, 20, 0.9); border-radius: 15px; border-width: 3px; border-color: rgb(139, 69, 19); margin-bottom: 15px; flex-direction: row; align-items: center; padding-left: 20px;">
                    <ui:VisualElement style="width: 40px; height: 40px; background-image: url(&quot;project://database/Assets/A%20lot%20of%20useful%20icons_05/png/icon_white/134.png?fileID=21300000&amp;guid=dfaf1b33f455f0c41a6037c399795495&amp;type=3#134&quot;); -unity-background-scale-mode: scale-to-fit; margin-right: 20px;" />
                    <ui:Label text="CRÉDITOS" style="font-size: 26px; color: rgb(255, 215, 0); -unity-font-style: bold; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0);" />
                </ui:Button>
                
                <!-- BOTÓN RANKING -->
                <ui:Button name="Boton_Ranking" class="boton-opcion" style="height: 80px; background-color: rgba(20, 20, 20, 0.9); border-radius: 15px; border-width: 3px; border-color: rgb(139, 69, 19); margin-bottom: 15px; flex-direction: row; align-items: center; padding-left: 20px;">
                    <ui:VisualElement style="width: 40px; height: 40px; background-image: url(&quot;project://database/Assets/A%20lot%20of%20useful%20icons_05/png/icon_white/122.png?fileID=21300000&amp;guid=f19245d751804bf4cb3de69c1a36c826&amp;type=3#122&quot;); -unity-background-scale-mode: scale-to-fit; margin-right: 20px;" />
                    <ui:Label text="RANKING" style="font-size: 26px; color: rgb(255, 215, 0); -unity-font-style: bold; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0);" />
                </ui:Button>
                
                <!-- BOTÓN VER PERFIL -->
                <ui:Button name="Boton_Perfil" class="boton-opcion" style="height: 80px; background-color: rgba(20, 20, 20, 0.9); border-radius: 15px; border-width: 3px; border-color: rgb(139, 69, 19); margin-bottom: 15px; flex-direction: row; align-items: center; padding-left: 20px;">
                    <ui:VisualElement style="width: 40px; height: 40px; background-image: url(&quot;project://database/Assets/A%20lot%20of%20useful%20icons_05/png/icon_white/153.png?fileID=21300000&amp;guid=1fe2bfd606d41cb4199b1023b6bf2a66&amp;type=3#153&quot;); -unity-background-scale-mode: scale-to-fit; margin-right: 20px;" />
                    <ui:Label text="VER PERFIL" style="font-size: 26px; color: rgb(255, 215, 0); -unity-font-style: bold; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0);" />
                </ui:Button>
                
                <!-- BOTÓN CERRAR SESIÓN -->
                <ui:Button name="Boton_CerrarSesion" class="boton-opcion" style="height: 80px; background-color: rgba(20, 20, 20, 0.9); border-radius: 15px; border-width: 3px; border-color: rgb(139, 69, 19); flex-direction: row; align-items: center; padding-left: 20px;">
                    <ui:VisualElement style="width: 40px; height: 40px; background-image: url(&quot;project://database/Assets/A%20lot%20of%20useful%20icons_05/png/icon_white/80.png?fileID=21300000&amp;guid=cff3165f7b458e740be13bcb944f91b8&amp;type=3#80&quot;); -unity-background-scale-mode: scale-to-fit; margin-right: 20px;" />
                    <ui:Label text="CERRAR SESIÓN" style="font-size: 26px; color: rgb(255, 215, 0); -unity-font-style: bold; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0);" />
                </ui:Button>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>