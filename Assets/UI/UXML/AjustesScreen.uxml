<!-- Panel Flotante de Perfil -->
<ui:VisualElement name="PanelPerfilOverlay" style="position: absolute; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.8); justify-content: center; align-items: center; display: none;">
    <ui:VisualElement name="ContenedorPerfil" style="width: 600px; background-color: rgba(20, 15, 10, 0.98); border-radius: 25px; border-width: 4px; border-color: rgb(255, 215, 0); padding: 40px;">
        
        <!-- Header -->
        <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 30px;">
            <ui:Label text="MI PERFIL" style="font-size: 38px; color: rgb(255, 215, 0); -unity-font-style: bold; -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(0, 0, 0, 0.8);" />
            <ui:Button name="Boton_CerrarPerfil" text="✖" style="width: 45px; height: 45px; font-size: 28px; background-color: rgba(139, 0, 0, 0.9); color: white; border-radius: 22px; border-width: 2px; border-color: rgb(255, 100, 100); -unity-font-style: bold;" />
        </ui:VisualElement>
        
        <!-- Estadísticas -->
        <ui:VisualElement style="background-color: rgba(0, 0, 0, 0.3); border-radius: 15px; padding: 25px; border-width: 2px; border-color: rgba(255, 215, 0, 0.3);">
