<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/PausaMenuEstilos.uss?fileID=7433441132597879392&amp;guid=f6f651282b7966b4f92692f899ae1a2e&amp;type=3#PausaMenuEstilos" />
    <Style src="project://database/Assets/UI/USS/GlobalAccesibilidad.uss?fileID=7433441132597879392&amp;guid=54de473943b1544468f4e32873b9414e&amp;type=3#GlobalAccesibilidad" />
    
    <!-- Boton de Pausa en la esquina (SIEMPRE VISIBLE) -->
    <ui:Button name="Boton_Pausa_Esquina" style="position: absolute; top: 20px; right: 20px; width: 70px; height: 70px; background-image: url(&quot;project://database/Assets/A%20lot%20of%20useful%20icons_05/png/icon_white/29.png?fileID=21300000&amp;guid=bee11f7b5212ac146919707950ca734a&amp;type=3#29&quot;); -unity-background-scale-mode: scale-to-fit; border-width: 0; background-color: rgba(0, 0, 0, 0);" />
    
    <!-- BARRA DE PROGRESO GD (HUD) -->
    <ui:VisualElement name="ContenedorProgresoHUD" style="position: absolute; top: 30px; left: 50%; translate: -50% 0; width: 400px; align-items: center;">
        <!-- Fondo de la barra -->
        <ui:VisualElement name="BarraFondo" style="width: 100%; height: 12px; background-color: rgba(0, 0, 0, 0.5); border-radius: 6px; border-width: 2px; border-color: rgba(255, 215, 0, 0.3); overflow: hidden;">
            <!-- Relleno de la barra -->
            <ui:VisualElement name="BarraRelleno" style="width: 0%; height: 100%; background-color: rgb(255, 215, 0);" />
        </ui:VisualElement>
        <!-- Texto del porcentaje -->
        <ui:Label name="Label_PorcentajeHUD" text="0%" style="margin-top: 5px; color: white; -unity-font-style: bold; font-size: 16px; -unity-text-outline-width: 1px; -unity-text-outline-color: black;" />
    </ui:VisualElement>
    
    <!-- Panel de Pausa FLOTANTE (Oculto por defecto) -->
    <ui:VisualElement name="PanelPausa" style="flex-grow: 1; width: 100%; height: 100%; position: absolute; background-color: rgba(0, 0, 0, 0.75); justify-content: center; align-items: center; display: none;">
        
        <!-- Contenedor central -->
        <ui:VisualElement name="ContenedorCentral" style="width: 80%; max-width: 900px; background-color: rgba(20, 15, 10, 0.95); border-radius: 30px; border-width: 5px; border-color: rgb(255, 215, 0); padding: 40px; align-items: center;">
            
            <!-- TITULO ELIMINADO -->
            
            <!-- Contenedor de Botones -->
            <ui:VisualElement name="ContenedorBotones" style="flex-direction: row; align-items: flex-end; justify-content: center; width: 100%; margin-bottom: 40px;">
                
                <!-- Columna: Boton MENU (izquierda) -->
                <ui:VisualElement style="align-items: center; margin-right: 40px;">
                    <ui:Button name="Boton_Menu" class="boton-pausa" style="background-image: url(&quot;project://database/Assets/ASSETS_MENUPAUSA/icon1.png&quot;); width: 150px; height: 150px; border-width: 0; background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit; margin-bottom: 10px;" />
                    <ui:Label text="MENU" style="font-size: 20px; color: white; -unity-font-style: bold; -unity-text-align: middle-center;" />
                </ui:VisualElement>
                
                <!-- Columna: Boton REANUDAR (centro, mas grande) -->
                <ui:VisualElement style="align-items: center; margin-left: 20px; margin-right: 20px;">
                    <ui:Button name="Boton_Play" class="boton-pausa boton-play-destacado" style="background-image: url(&quot;project://database/Assets/ASSETS_MENUPAUSA/icon2.png&quot;); width: 220px; height: 220px; border-width: 0; background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit; margin-bottom: 10px;" />
                    <ui:Label text="REANUDAR" style="font-size: 22px; color: white; -unity-font-style: bold; -unity-text-align: middle-center;" />
                </ui:VisualElement>
                
                <!-- Columna: Boton REINICIAR (derecha) -->
                <ui:VisualElement style="align-items: center; margin-left: 40px;">
                    <ui:Button name="Boton_Reiniciar" class="boton-pausa" style="background-image: url(&quot;project://database/Assets/ASSETS_MENUPAUSA/icon3.png&quot;); width: 150px; height: 150px; border-width: 0; background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit; margin-bottom: 10px;" />
                    <ui:Label text="REINICIAR" style="font-size: 20px; color: white; -unity-font-style: bold; -unity-text-align: middle-center;" />
                </ui:VisualElement>
            </ui:VisualElement>
            
            <!-- Controles de Audio -->
            <ui:VisualElement name="ContenedorSliders" style="width: 80%; background-color: rgba(10, 15, 30, 0.9); padding: 30px; border-radius: 20px; border-width: 3px; border-color: rgb(139, 69, 19);">
                
                <!-- Control Musica -->
                <ui:VisualElement name="ControlMusica" style="width: 100%; margin-bottom: 25px;">
                    <ui:Label text="MÚSICA" style="font-size: 28px; color: rgb(255, 215, 0); -unity-font-style: bold; margin-bottom: 10px; -unity-text-align: upper-center; -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(0, 0, 0, 0.8);" />
                    <ui:Slider name="Slider_Musica" high-value="100" low-value="0" value="75" direction="Horizontal" style="width: 100%; height: 25px;" />
                </ui:VisualElement>
                
                <!-- Control SFX -->
                <ui:VisualElement name="ControlSFX" style="width: 100%;">
                    <ui:Label text="SFX" style="font-size: 28px; color: rgb(255, 215, 0); -unity-font-style: bold; margin-bottom: 10px; -unity-text-align: upper-center; -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(0, 0, 0, 0.8);" />
                    <ui:Slider name="Slider_SFX" high-value="100" low-value="0" value="75" direction="Horizontal" style="width: 100%; height: 25px;" />
                </ui:VisualElement>
            </ui:VisualElement>
            
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
