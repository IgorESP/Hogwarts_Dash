<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/PausaMenuEstilos.uss?fileID=7433441132597879392&amp;guid=f6f651282b7966b4f92692f899ae1a2e&amp;type=3#PausaMenuEstilos" />
    <Style src="project://database/Assets/UI/USS/GlobalAccesibilidad.uss?fileID=7433441132597879392&amp;guid=54de473943b1544468f4e32873b9414e&amp;type=3#GlobalAccesibilidad" />
    <ui:VisualElement name="PanelPausa" style="flex-grow: 1; width: 100%; height: 100%; position: absolute; background-image: url(&quot;project://database/Assets/ASSETS_MENUS/fondo%20(1).png?fileID=-8179682795298691854&amp;guid=0ae676ad7a14f814c9b9fbe500038b98&amp;type=3#fondo (1)_0&quot;); -unity-background-scale-mode: scale-and-crop; justify-content: center; align-items: center; -unity-background-image-tint-color: rgb(80, 70, 60); display: none;">
        <ui:VisualElement name="Titulo" style="background-image: url(&quot;project://database/Assets/ASSETS_MENUPAUSA/quidditch_pitch.PNG?fileID=-4840984467663090459&amp;guid=ef5db9b5f970ba645807dd10c7b54b00&amp;type=3#quidditch_pitch_0&quot;); position: absolute; align-self: center; width: 50%; height: 10%; top: 5%; -unity-background-scale-mode: scale-to-fit;" />
        <ui:VisualElement name="ContenedorBotones" style="flex-direction: row; align-items: center; justify-content: center; width: 100%; position: absolute; top: 28%; gap: 50px;">
            <ui:Button name="Boton_Info" class="boton-pausa" style="background-image: url(&quot;project://database/Assets/ASSETS_MENUPAUSA/botonp2.png?fileID=-3262905147996909617&amp;guid=7c132aaa1279a8147a36e5c9718a081e&amp;type=3#boton_p2_sin_fondo_0&quot;); width: 150px; height: 150px; border-width: 0; background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit;" />
            <ui:Button name="Boton_Play" class="boton-pausa boton-play-destacado" style="background-image: url(&quot;project://database/Assets/ASSETS_MENUPAUSA/botonp.png?fileID=-6234771884946319371&amp;guid=49e3f5b20e60df7448d8685c59287407&amp;type=3#boton_p_sin_fondo_0&quot;); width: 180px; height: 180px; border-width: 4px; border-color: rgb(255, 215, 0); background-color: rgba(255, 215, 0, 0.2); -unity-background-scale-mode: scale-to-fit; border-radius: 50%;" />
            <ui:Button name="Boton_Reiniciar" class="boton-pausa" style="background-image: url(&quot;project://database/Assets/ASSETS_MENUPAUSA/botonpro.png?fileID=-7233256923305594659&amp;guid=5adfa8dd1f7c0fd46a5434ef4c7119c0&amp;type=3#boton_pro_sin_fondo_0&quot;); width: 150px; height: 150px; border-width: 0; background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit;" />
        </ui:VisualElement>
        <ui:VisualElement name="ContenedorSliders" style="width: 50%; max-width: 600px; position: absolute; top: 55%; background-color: rgba(10, 15, 30, 0.9); padding: 40px; border-radius: 20px; border-width: 3px; border-color: rgb(139, 69, 19);">
            <ui:VisualElement name="ControlMusica" style="width: 100%; margin-bottom: 35px;">
                <ui:Label text="MÚSICA" style="font-size: 36px; color: rgb(255, 215, 0); -unity-font-style: bold; margin-bottom: 15px; -unity-text-align: upper-center; -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(0, 0, 0, 0.8);" />
                <ui:Slider name="Slider_Musica" high-value="100" low-value="0" value="80" direction="Horizontal" style="width: 100%; height: 30px;" />
            </ui:VisualElement>
            <ui:VisualElement name="ControlSFX" style="width: 100%;">
                <ui:Label text="EFECTOS" style="font-size: 36px; color: rgb(255, 215, 0); -unity-font-style: bold; margin-bottom: 15px; -unity-text-align: upper-center; -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(0, 0, 0, 0.8);" />
                <ui:Slider name="Slider_SFX" high-value="100" low-value="0" value="80" direction="Horizontal" style="width: 100%; height: 30px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Button name="Boton_Pausa_Esquina" style="position: absolute; top: 20px; right: 20px; width: 70px; height: 70px; background-image: url(&quot;project://database/Assets/A%20lot%20of%20useful%20icons_05/png/icon_white/29.png?fileID=21300000&amp;guid=bee11f7b5212ac146919707950ca734a&amp;type=3#29&quot;); -unity-background-scale-mode: scale-to-fit; border-width: 0; background-color: rgba(0, 0, 0, 0);" />
</ui:UXML>
