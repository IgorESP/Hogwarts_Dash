<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/PausaMenuEstilos.uss" />
    
    <ui:VisualElement name="PanelPausa" style="flex-grow: 1; width: 100%; height: 100%; position: absolute; background-image: url('project://database/Assets/ASSETS_MENUS/fondo (1).png'); -unity-background-scale-mode: scale-and-crop; justify-content: center; align-items: center; -unity-background-image-tint-color: rgb(80, 70, 60); display: none;">
        
        <!-- TÍTULO QUIDDITCH PITCH -->
        <ui:VisualElement name="Titulo" style="background-image: url('project://database/Assets/ASSETS_MENUPAUSA/quidditch_pitch.png'); position: absolute; align-self: center; width: 50%; height: 10%; top: 5%; -unity-background-scale-mode: scale-to-fit;" />
        
        <!-- BOTONES: INFO - PLAY (CENTRO) - REINICIAR -->
        <ui:VisualElement name="ContenedorBotones" style="flex-direction: row; align-items: center; justify-content: center; width: 100%; position: absolute; top: 28%; gap: 50px;">
            
            <!-- BOTÓN INFO (IZQUIERDA) -->
            <ui:Button name="Boton_Info" class="boton-pausa" style="background-image: url('project://database/Assets/ASSETS_MENUPAUSA/botonp2.png'); width: 150px; height: 150px; border-width: 0; background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit;" />
            
            <!-- BOTÓN PLAY (CENTRO - DESTACADO) -->
            <ui:Button name="Boton_Play" class="boton-pausa boton-play-destacado" style="background-image: url('project://database/Assets/ASSETS_MENUPAUSA/botonp.png'); width: 180px; height: 180px; border-width: 4px; border-color: rgb(255, 215, 0); background-color: rgba(255, 215, 0, 0.2); -unity-background-scale-mode: scale-to-fit; border-radius: 50%;" />
            
            <!-- BOTÓN REINICIAR (DERECHA) -->
            <ui:Button name="Boton_Reiniciar" class="boton-pausa" style="background-image: url('project://database/Assets/ASSETS_MENUPAUSA/botonpro.png'); width: 150px; height: 150px; border-width: 0; background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit;" />
            
        </ui:VisualElement>
        
        <!-- SLIDERS DE AUDIO -->
        <ui:VisualElement name="ContenedorSliders" style="width: 50%; max-width: 600px; position: absolute; top: 55%; background-color: rgba(10, 15, 30, 0.9); padding: 40px; border-radius: 20px; border-width: 3px; border-color: rgb(139, 69, 19);">
            
            <!-- CONTROL MÚSICA -->
            <ui:VisualElement name="ControlMusica" style="width: 100%; margin-bottom: 35px;">
                <ui:Label text="MÚSICA" style="font-size: 36px; color: rgb(255, 215, 0); -unity-font-style: bold; margin-bottom: 15px; -unity-text-align: upper-center; -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(0, 0, 0, 0.8);" />
                <ui:Slider name="Slider_Musica" high-value="100" low-value="0" value="80" direction="Horizontal" style="width: 100%; height: 30px;" />
            </ui:VisualElement>
            
            <!-- CONTROL SFX -->
            <ui:VisualElement name="ControlSFX" style="width: 100%;">
                <ui:Label text="EFECTOS" style="font-size: 36px; color: rgb(255, 215, 0); -unity-font-style: bold; margin-bottom: 15px; -unity-text-align: upper-center; -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(0, 0, 0, 0.8);" />
                <ui:Slider name="Slider_SFX" high-value="100" low-value="0" value="80" direction="Horizontal" style="width: 100%; height: 30px;" />
            </ui:VisualElement>
            
        </ui:VisualElement>
        
    </ui:VisualElement>
    
    <!-- BOTÓN DE PAUSA EN ESQUINA -->
    <ui:Button name="Boton_Pausa_Esquina" style="position: absolute; top: 20px; right: 20px; width: 70px; height: 70px; background-image: url('project://database/Assets/A lot of useful icons_05/png/icon_white/29.png'); -unity-background-scale-mode: scale-to-fit; border-width: 0; background-color: rgba(0, 0, 0, 0);" />
    
</ui:UXML>