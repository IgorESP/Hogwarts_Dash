            <ui:Button name="Mundo_2" class="tarjeta-mundo desbloqueado" style="width: 250px; height: 350px; margin: 15px; background-color: rgba(20, 20, 20, 0.85); border-width: 4px; border-color: rgb(0, 200, 100); border-radius: 20px; padding: 20px;">
