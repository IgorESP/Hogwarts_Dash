                <ui:Label text="Oscuridad y peligros bajo el castillo. Solo para los más valientes." style="font-size: 14px; color: rgb(130, 130, 130); flex-wrap: wrap; white-space: normal; margin-bottom: 20px;" />
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-top: auto;">
