                <ui:Label text="Las estrellas guían tu camino. Gravedad inestable y ritmos celestiales." style="font-size: 14px; color: rgb(200, 200, 200); flex-wrap: wrap; white-space: normal; margin-bottom: 20px;" />
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-top: auto;">
