<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/LoginEstilos.uss?fileID=7433441132597879392&amp;guid=a6f5de981a4bddc41a5ff90d1696b5f1&amp;type=3#LoginEstilos" />
    <ui:VisualElement name="Contenedor" style="flex-grow: 1; width: 100%; height: 100%; position: absolute; background-image: url(&quot;project://database/Assets/ASSETS_MENUS/fondo%20(1).png?fileID=2800000&amp;guid=0ae676ad7a14f814c9b9fbe500038b98&amp;type=3#fondo (1)&quot;); -unity-background-scale-mode: scale-and-crop; justify-content: center; align-items: center; padding-top: 150px; -unity-background-image-tint-color: rgb(108, 103, 103);">
        <ui:Label name="Titulo" style="background-image: url(&quot;project://database/Assets/ASSETS_MENUS/titulo%20(1).png?fileID=2800000&amp;guid=4f5830131bc7dcd469c1a72a375836d2&amp;type=3#titulo (1)&quot;); position: absolute; align-self: center; width: 40%; height: 15%; top: 5%; -unity-background-scale-mode: scale-to-fit;" />
        <ui:VisualElement name="PanelRegistro" style="width: 500px; background-color: rgba(25, 20, 15, 0.95); border-radius: 25px; padding: 30px 40px; border-width: 4px; border-color: rgb(139, 69, 19); align-items: center; margin-top: 80px;">
            <ui:Label text="Crear Cuenta" style="font-size: 28px; color: rgb(255, 215, 0); margin-bottom: 20px; -unity-font-style: bold; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0);" />
            <ui:VisualElement name="ContenedorNombre" style="width: 100%; margin-bottom: 12px;">
                <ui:Label text="Nombre" style="font-size: 16px; color: rgb(255, 215, 0); margin-bottom: 6px; margin-left: 5px; -unity-font-style: bold;" />
                <ui:VisualElement name="CampoNombre" class="campo-input" style="flex-direction: row; align-items: center; background-color: rgba(40, 35, 25, 0.9); border-radius: 10px; padding: 10px 12px; border-width: 2px; border-color: rgb(100, 50, 15);">
                    <ui:VisualElement style="width: 24px; height: 24px; background-image: url(&quot;project://database/Assets/A%20lot%20of%20useful%20icons_05/png/icon_white/150.png?fileID=21300000&amp;guid=2badcda32dbeead47a2e21aef9e8a3e3&amp;type=3#150&quot;); -unity-background-scale-mode: scale-to-fit; margin-right: 10px; -unity-background-image-tint-color: rgb(255, 215, 0);" />
                    <ui:TextField name="Campo_Nombre" placeholder-text="Tu nombre" style="flex-grow: 1; font-size: 16px; background-color: rgba(0, 0, 0, 0); border-width: 0; color: white; -unity-text-align: middle-left;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="ContenedorApellido" style="width: 100%; margin-bottom: 12px;">
                <ui:Label text="Apellido" style="font-size: 16px; color: rgb(255, 215, 0); margin-bottom: 6px; margin-left: 5px; -unity-font-style: bold;" />
                <ui:VisualElement name="CampoApellido" class="campo-input" style="flex-direction: row; align-items: center; background-color: rgba(40, 35, 25, 0.9); border-radius: 10px; padding: 10px 12px; border-width: 2px; border-color: rgb(100, 50, 15);">
                    <ui:VisualElement style="width: 24px; height: 24px; background-image: url(&quot;project://database/Assets/A%20lot%20of%20useful%20icons_05/png/icon_white/150.png?fileID=21300000&amp;guid=2badcda32dbeead47a2e21aef9e8a3e3&amp;type=3#150&quot;); -unity-background-scale-mode: scale-to-fit; margin-right: 10px; -unity-background-image-tint-color: rgb(255, 215, 0);" />
                    <ui:TextField name="Campo_Apellido" placeholder-text="Tu apellido" style="flex-grow: 1; font-size: 16px; background-color: rgba(0, 0, 0, 0); border-width: 0; color: white; -unity-text-align: middle-left;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="ContenedorContrasena" style="width: 100%; margin-bottom: 12px;">
                <ui:Label text="Contraseña" style="font-size: 16px; color: rgb(255, 215, 0); margin-bottom: 6px; margin-left: 5px; -unity-font-style: bold;" />
                <ui:VisualElement name="CampoContrasena" class="campo-input" style="flex-direction: row; align-items: center; background-color: rgba(40, 35, 25, 0.9); border-radius: 10px; padding: 10px 12px; border-width: 2px; border-color: rgb(100, 50, 15);">
                    <ui:VisualElement style="width: 24px; height: 24px; background-image: url(&quot;project://database/Assets/A%20lot%20of%20useful%20icons_05/png/icon_white/55.png?fileID=21300000&amp;guid=587f6cf8173862343bdcec2c98bdb00f&amp;type=3#55&quot;); -unity-background-scale-mode: scale-to-fit; margin-right: 10px; -unity-background-image-tint-color: rgb(255, 215, 0);" />
                    <ui:TextField name="Campo_Contrasena" placeholder-text="••••••••" password="true" style="flex-grow: 1; font-size: 16px; background-color: rgba(0, 0, 0, 0); border-width: 0; color: white; -unity-text-align: middle-left;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="ContenedorConfirmar" style="width: 100%; margin-bottom: 15px;">
                <ui:Label text="Confirmar Contraseña" style="font-size: 16px; color: rgb(255, 215, 0); margin-bottom: 6px; margin-left: 5px; -unity-font-style: bold;" />
                <ui:VisualElement name="CampoConfirmar" class="campo-input" style="flex-direction: row; align-items: center; background-color: rgba(40, 35, 25, 0.9); border-radius: 10px; padding: 10px 12px; border-width: 2px; border-color: rgb(100, 50, 15);">
                    <ui:VisualElement style="width: 24px; height: 24px; background-image: url(&quot;project://database/Assets/A%20lot%20of%20useful%20icons_05/png/icon_white/55.png?fileID=21300000&amp;guid=587f6cf8173862343bdcec2c98bdb00f&amp;type=3#55&quot;); -unity-background-scale-mode: scale-to-fit; margin-right: 10px; -unity-background-image-tint-color: rgb(255, 215, 0);" />
                    <ui:TextField name="Campo_Confirmar" placeholder-text="••••••••" password="true" style="flex-grow: 1; font-size: 16px; background-color: rgba(0, 0, 0, 0); border-width: 0; color: white; -unity-text-align: middle-left;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="Mensaje_Error" style="font-size: 14px; color: rgb(255, 100, 100); margin-bottom: 12px; -unity-font-style: bold; display: none; -unity-text-align: middle-center; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0);" />
            <ui:Button name="Boton_Crear" text="✓ CREAR CUENTA" class="boton-login" style="width: 100%; height: 60px; font-size: 20px; background-color: rgb(15, 140, 45); color: white; border-radius: 12px; border-width: 3px; border-color: rgb(20, 180, 60); margin-bottom: 10px; -unity-font-style: bold; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0);" />
            <ui:VisualElement style="width: 100%; height: 2px; background-color: rgba(150, 150, 150, 0.3); margin-bottom: 10px;" />
            <ui:Button name="Boton_Volver" text="← Volver al Login" class="boton-login" style="width: 100%; height: 50px; font-size: 18px; background-color: rgba(139, 69, 19, 0.95); color: rgb(255, 215, 0); border-radius: 12px; border-width: 3px; border-color: rgb(180, 120, 60); -unity-font-style: bold; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0);" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
