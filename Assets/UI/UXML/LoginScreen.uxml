<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/LoginEstilos.uss?fileID=7433441132597879392&amp;guid=a6f5de981a4bddc41a5ff90d1696b5f1&amp;type=3#LoginEstilos" />
    <ui:VisualElement name="Contenedor" style="flex-grow: 1; width: 100%; height: 100%; position: absolute; background-image: url(&quot;project://database/Assets/ASSETS_MENUS/fondo%20(1).png?fileID=2800000&amp;guid=0ae676ad7a14f814c9b9fbe500038b98&amp;type=3#fondo (1)&quot;); -unity-background-scale-mode: scale-and-crop; justify-content: center; align-items: center; -unity-background-image-tint-color: rgb(108, 103, 103);">
        <ui:Label name="Titulo" style="background-image: url(&quot;project://database/Assets/ASSETS_MENUS/titulo%20(1).png?fileID=2800000&amp;guid=4f5830131bc7dcd469c1a72a375836d2&amp;type=3#titulo (1)&quot;); position: absolute; align-self: center; width: 40%; height: 15%; top: 8%; -unity-background-scale-mode: scale-to-fit;" />
        <ui:VisualElement name="PanelLogin" style="width: 450px; background-color: rgba(25, 20, 15, 0.95); border-radius: 25px; padding: 35px 40px; border-width: 4px; border-color: rgb(139, 69, 19); align-items: center;">
            <ui:Label text="Iniciar Sesión" style="font-size: 32px; color: rgb(255, 215, 0); margin-bottom: 30px; -unity-font-style: bold; -unity-text-outline-width: 3px; -unity-text-outline-color: rgb(0, 0, 0);" />
            <ui:VisualElement name="ContenedorUsuario" style="width: 100%; margin-bottom: 20px;">
                <ui:Label text="Usuario" style="font-size: 18px; color: rgb(255, 215, 0); margin-bottom: 8px; margin-left: 5px; -unity-font-style: bold;" />
                <ui:VisualElement name="CampoUsuario" class="campo-input" style="flex-direction: row; align-items: center; background-color: rgba(40, 35, 25, 0.9); border-radius: 12px; padding: 12px 15px; border-width: 2px; border-color: rgb(100, 50, 15);">
                    <ui:VisualElement style="width: 28px; height: 28px; background-image: url(&quot;project://database/Assets/A%20lot%20of%20useful%20icons_05/png/icon_white/153.png?fileID=21300000&amp;guid=1fe2bfd606d41cb4199b1023b6bf2a66&amp;type=3#153&quot;); -unity-background-scale-mode: scale-to-fit; margin-right: 12px; -unity-background-image-tint-color: rgb(255, 215, 0);" />
                    <ui:TextField name="Campo_Usuario" placeholder-text="Ingresa tu usuario" style="flex-grow: 1; font-size: 18px; background-color: rgba(0, 0, 0, 0); border-width: 0; color: white; -unity-text-align: middle-left;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="ContenedorContrasena" style="width: 100%; margin-bottom: 20px;">
                <ui:Label text="Contraseña" style="font-size: 18px; color: rgb(255, 215, 0); margin-bottom: 8px; margin-left: 5px; -unity-font-style: bold;" />
                <ui:VisualElement name="CampoContrasena" class="campo-input" style="flex-direction: row; align-items: center; background-color: rgba(40, 35, 25, 0.9); border-radius: 12px; padding: 12px 15px; border-width: 2px; border-color: rgb(100, 50, 15);">
                    <ui:VisualElement style="width: 28px; height: 28px; background-image: url(&quot;project://database/Assets/A%20lot%20of%20useful%20icons_05/png/icon_white/55.png?fileID=21300000&amp;guid=587f6cf8173862343bdcec2c98bdb00f&amp;type=3#55&quot;); -unity-background-scale-mode: scale-to-fit; margin-right: 12px; -unity-background-image-tint-color: rgb(255, 215, 0);" />
                    <ui:TextField name="Campo_Contrasena" placeholder-text="••••••••" password="true" style="flex-grow: 1; font-size: 18px; background-color: rgba(0, 0, 0, 0); border-width: 0; color: white; -unity-text-align: middle-left;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="Mensaje_Error" style="font-size: 16px; color: rgb(255, 100, 100); margin-bottom: 18px; -unity-font-style: bold; display: none; -unity-text-align: middle-center; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0);" />
            <ui:Button name="Boton_IniciarSesion" text="✓ INICIAR SESIÓN" class="boton-login" style="width: 100%; height: 65px; font-size: 22px; background-color: rgb(15, 140, 45); color: white; border-radius: 12px; border-width: 3px; border-color: rgb(20, 180, 60); margin-bottom: 12px; -unity-font-style: bold; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0);" />
            <ui:VisualElement style="width: 100%; height: 2px; background-color: rgba(150, 150, 150, 0.3); margin-bottom: 12px;" />
            <ui:Button name="Boton_Registrarse" text="+ REGISTRARSE" class="boton-login" style="width: 100%; height: 65px; font-size: 22px; background-color: rgba(139, 69, 19, 0.95); color: rgb(255, 215, 0); border-radius: 12px; border-width: 3px; border-color: rgb(180, 120, 60); -unity-font-style: bold; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0);" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
