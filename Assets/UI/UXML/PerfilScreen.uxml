<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" schemaLocation="UnityEngine.UIElements ../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">

    <Style src="project://database/Assets/UI/USS/PerfilEstilos.uss?fileID=7433441132597879392&amp;guid=44d1f634f2db7664eb577fa3fc3829ec&amp;type=3#PerfilEstilos" />
    <Style src="project://database/Assets/UI/USS/GlobalAccesibilidad.uss?fileID=7433441132597879392&amp;guid=54de473943b1544468f4e32873b9414e&amp;type=3#GlobalAccesibilidad" />

   <ui:VisualElement name="Contenedor" style="flex-grow: 1; width: 100%; height: 100%; position: absolute; background-image: url(&quot;project://database/Assets/ASSETS_MENUS/fondo%20(1).png?fileID=2800000&amp;guid=0ae676ad7a14f814c9b9fbe500038b98&amp;type=3#fondo (1)&quot;); -unity-background-scale-mode: scale-and-crop; justify-content: center; align-items: center; background-color: rgb(108, 103, 103); -unity-background-image-tint-color: rgb(108, 103, 103);">
        
        <!-- Botón volver al menú principal (esquina superior izquierda) -->
        <ui:Button name="Boton_Volver" text="← ATRÁS" style="position: absolute; top: 1.5%; left: 1.5%; width: 140px; height: 55px; font-size: 20px; background-color: rgba(139, 69, 19, 0.95); color: rgb(255, 215, 0); border-radius: 12px; border-width: 3px; border-color: rgb(180, 120, 60); -unity-font-style: bold;" />
        
        <!-- Título de la pantalla -->
        <ui:Label text="SELECCIONA TU CASA" style="font-size: 32px; color: rgb(255, 215, 0); margin-bottom: 20px; -unity-font-style: bold; -unity-text-outline-width: 4px; -unity-text-outline-color: rgba(0, 0, 0, 0.9);" />
        
        <!-- Panel central -->
        <ui:VisualElement name="PanelPrincipal" style="background-color: rgba(15, 10, 5, 0.85); border-radius: 25px; padding: 25px; border-width: 4px; border-color: rgb(139, 69, 19); width: 90%; max-width: 850px; align-items: center;">
            <ui:VisualElement style="align-items: center;">
                
                <!-- Fila de botones de selección de casa -->
                <ui:VisualElement name="ContenedorCasas" style="flex-direction: row; justify-content: center; align-items: center; margin-bottom: 25px; flex-wrap: wrap; width: 100%;">
                    <ui:Button name="Boton_Gryffindor" class="boton-casa" style="background-image: url(&quot;project://database/Assets/ASSETS_CUBOS/CUBO1.png?fileID=1026339336&amp;guid=7dfad456f7ec77549965e31b3676492d&amp;type=3#CUBO1_0&quot;); width: 160px; height: 160px; margin: 10px; background-color: rgba(0, 0, 0, 0); border-width: 4px; border-color: rgb(180, 50, 50); border-radius: 18px; -unity-background-scale-mode: scale-to-fit;" />
                    <ui:Button name="Boton_Hufflepuff" class="boton-casa" style="background-image: url(&quot;project://database/Assets/ASSETS_CUBOS/CUBO2.png?fileID=-2102443775&amp;guid=e4b035cec741f084ab049f7e76735f6c&amp;type=3#CUBO2_0&quot;); width: 160px; height: 160px; margin: 10px; background-color: rgba(0, 0, 0, 0); border-width: 4px; border-color: rgb(200, 150, 50); border-radius: 18px; -unity-background-scale-mode: scale-to-fit;" />
                    <ui:Button name="Boton_Ravenclaw" class="boton-casa" style="background-image: url(&quot;project://database/Assets/ASSETS_CUBOS/CUBO3.png?fileID=8646343858890659315&amp;guid=88561b6fb3896214baf5faacca6e4d46&amp;type=3#cubo_ravenclaw_0&quot;); width: 160px; height: 160px; margin: 10px; background-color: rgba(0, 0, 0, 0); border-width: 4px; border-color: rgb(50, 90, 150); border-radius: 18px; -unity-background-scale-mode: scale-to-fit;" />
                    <ui:Button name="Boton_Slytherin" class="boton-casa" style="background-image: url(&quot;project://database/Assets/ASSETS_CUBOS/CUBO4.png?fileID=-8318489692804935999&amp;guid=aacc3e1ebfe0b4b4494b7cfd110bd17f&amp;type=3#cubo_slytherin_0&quot;); width: 160px; height: 160px; margin: 10px; background-color: rgba(0, 0, 0, 0); border-width: 4px; border-color: rgb(60, 120, 70); border-radius: 18px; -unity-background-scale-mode: scale-to-fit;" />
                </ui:VisualElement>

                <!-- Botón confirmar selección y entrar al juego -->
                <ui:Button name="Boton_Confirmar" text="✓ ENTRAR AL JUEGO" style="width: 320px; height: 65px; font-size: 24px; border-radius: 18px; background-color: rgb(15, 140, 45); color: white; border-width: 4px; border-color: rgb(20, 180, 60); -unity-font-style: bold; margin-top: 10px;" />

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
    
</ui:UXML>
