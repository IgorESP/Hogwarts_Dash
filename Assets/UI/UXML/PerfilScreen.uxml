<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" xsi:schemaLocation="UnityEngine.UIElements ../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    
    <Style src="project://database/Assets/UI/USS/PerfilEstilos.uss?fileID=7433441132597879392&amp;guid=44d1f634f2db7664eb577fa3fc3829ec&amp;type=3#PerfilEstilos" />
    
    <ui:VisualElement name="Contenedor" style="flex-grow: 1; width: 100%; height: 100%; position: absolute; background-image: url(&apos;project://database/Assets/ASSETS_MENUS/fondo%20(1).png?fileID=2800000&amp;guid=0ae676ad7a14f814c9b9fbe500038b98&amp;type=3#fondo (1)&apos;); -unity-background-scale-mode: scale-and-crop; align-items: center; justify-content: center; -unity-background-image-tint-color: rgb(108, 103, 103);">
        
        <ui:Button name="Boton_Volver" text="← ATRÁS" style="position: absolute; top: 25px; left: 25px; width: 140px; height: 55px; font-size: 20px; background-color: rgba(139, 69, 19, 0.95); color: rgb(255, 215, 0); border-radius: 12px; border-width: 3px; border-color: rgb(180, 120, 60); -unity-font-style: bold;" />
        
        <ui:Label text="SELECCIONA TU CASA" style="font-size: 42px; color: rgb(255, 215, 0); margin-bottom: 20px; -unity-font-style: bold; -unity-text-outline-width: 4px; -unity-text-outline-color: rgba(0, 0, 0, 0.9);" />
        
        <ui:VisualElement name="PanelPrincipal" style="background-color: rgba(15, 10, 5, 0.85); border-radius: 25px; padding: 25px; border-width: 4px; border-color: rgb(139, 69, 19); width: 90%; max-width: 850px; align-items: center;">
            
            <ui:ScrollView style="width: 100%;">
                <ui:VisualElement style="align-items: center;">
                    
                    <ui:VisualElement name="ContenedorCasas" style="flex-direction: row; justify-content: center; align-items: center; margin-bottom: 25px; flex-wrap: wrap; width: 100%;">
                        <ui:Button name="Boton_Gryffindor" class="boton-casa" style="background-image: url(&apos;project://database/Assets/ASSETS_CUBOS/CUBO1.png?fileID=8732451491206344441&amp;guid=7dfad456f7ec77549965e31b3676492d&amp;type=3#cubo_gryffindor_0&apos;); width: 160px; height: 160px; margin: 10px; background-color: rgba(0, 0, 0, 0); border-width: 4px; border-color: rgb(180, 50, 50); border-radius: 18px; -unity-background-scale-mode: scale-to-fit;" />
                        <ui:Button name="Boton_Hufflepuff" class="boton-casa" style="background-image: url(&apos;project://database/Assets/ASSETS_CUBOS/CUBO2.png?fileID=-8772699260811039704&amp;guid=e4b035cec741f084ab049f7e76735f6c&amp;type=3#cubo_hufflepuff_0&apos;); width: 160px; height: 160px; margin: 10px; background-color: rgba(0, 0, 0, 0); border-width: 4px; border-color: rgb(200, 150, 50); border-radius: 18px; -unity-background-scale-mode: scale-to-fit;" />
                        <ui:Button name="Boton_Ravenclaw" class="boton-casa" style="background-image: url(&apos;project://database/Assets/ASSETS_CUBOS/CUBO3.png?fileID=8646343858890659315&amp;guid=88561b6fb3896214baf5faacca6e4d46&amp;type=3#cubo_ravenclaw_0&apos;); width: 160px; height: 160px; margin: 10px; background-color: rgba(0, 0, 0, 0); border-width: 4px; border-color: rgb(50, 90, 150); border-radius: 18px; -unity-background-scale-mode: scale-to-fit;" />
                        <ui:Button name="Boton_Slytherin" class="boton-casa" style="background-image: url(&apos;project://database/Assets/ASSETS_CUBOS/CUBO4.png?fileID=-8318489692804935999&amp;guid=aacc3e1ebfe0b4b4494b7cfd110bd17f&amp;type=3#cubo_slytherin_0&apos;); width: 160px; height: 160px; margin: 10px; background-color: rgba(0, 0, 0, 0); border-width: 4px; border-color: rgb(60, 120, 70); border-radius: 18px; -unity-background-scale-mode: scale-to-fit;" />
                    </ui:VisualElement>

                    <ui:VisualElement style="width: 80%; height: 3px; background-color: rgba(255, 215, 0, 0.4); margin-bottom: 20px; border-radius: 2px;" />
                    <ui:Label text="TU PERSONAJE" style="font-size: 26px; color: rgb(255, 215, 0); margin-bottom: 15px; -unity-font-style: bold;" />

                    <ui:VisualElement name="ContenedorIconos" style="flex-direction: row; justify-content: center; align-items: center; margin-bottom: 25px; flex-wrap: wrap; width: 95%; background-color: rgba(0, 0, 0, 0.3); padding: 15px; border-radius: 20px; border-width: 2px; border-color: rgba(255, 215, 0, 0.3);">
                        <ui:VisualElement name="Icono_Cubo" class="icono-casa" style="width: 90px; height: 90px; margin: 10px; -unity-background-scale-mode: scale-to-fit; background-color: rgba(0, 0, 0, 0); border-radius: 15px; border-width: 2px; border-color: rgba(255, 215, 0, 0.4);" />
                        <ui:VisualElement name="Icono_Bola" class="icono-casa" style="width: 90px; height: 90px; margin: 10px; -unity-background-scale-mode: scale-to-fit; background-color: rgba(0, 0, 0, 0); border-radius: 15px; border-width: 2px; border-color: rgba(255, 215, 0, 0.4);" />
                        <ui:VisualElement name="Icono_Cohete" class="icono-casa" style="width: 90px; height: 90px; margin: 10px; -unity-background-scale-mode: scale-to-fit; background-color: rgba(0, 0, 0, 0); border-radius: 15px; border-width: 2px; border-color: rgba(255, 215, 0, 0.4);" />
                        <ui:VisualElement name="Icono_UFO" class="icono-casa" style="width: 90px; height: 90px; margin: 10px; -unity-background-scale-mode: scale-to-fit; background-color: rgba(0, 0, 0, 0); border-radius: 15px; border-width: 2px; border-color: rgba(255, 215, 0, 0.4);" />
                    </ui:VisualElement>

                    <ui:Button name="Boton_Confirmar" text="✓ ENTRAR AL JUEGO" style="width: 320px; height: 65px; font-size: 24px; border-radius: 18px; background-color: rgb(15, 140, 45); color: white; border-width: 4px; border-color: rgb(20, 180, 60); -unity-font-style: bold;" />
                
                </ui:VisualElement>
            </ui:ScrollView>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>